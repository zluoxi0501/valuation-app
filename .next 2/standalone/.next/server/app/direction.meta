{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/direction/layout,_N_T_/direction/page,_N_T_/direction"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/direction/__PAGE__",
    "/direction",
    "/_index",
    "/_head"
  ]
}